{
  "name": "vocabulary-ledger-android-offline",
  "version": "1.3.0",
  "private": true,
  "description": "Standalone offline Android APK project for Vocabulary Ledger (Capacitor + Android)",
  "scripts": {
    "sync:web": "node scripts/sync-web.mjs",
    "cap:sync": "node scripts/sync-web.mjs && npx cap sync android",
    "apk:debug": "node scripts/build-apk.mjs",
    "test:offline": "node --test tests/android-offline.test.mjs tests/browser-e2e.test.mjs",
    "apk:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
